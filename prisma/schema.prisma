generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Lead {
  id             String   @id @default(cuid())
  enquiryType    String   @default("HEALTH_CHECKUP")
  fullName       String
  mobile         String
  whatsapp       String
  email          String?
  state          String
  district       String
  area           String
  pincode        String
  age            String?
  gender         String?
  package        String?
  price          String?
  membershipType String?
  serviceType    String?
  status         String   @default("New Lead")
  createdAt      DateTime @default(now())
}

model HealthPackage {
  id            String   @id @default(cuid())
  slug          String?  @unique
  title         String
  subtitle      String
  price         String
  originalPrice String
  discount      String
  theme         String   @default("themePink")
  image         String
  layout        String   @default("left")
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

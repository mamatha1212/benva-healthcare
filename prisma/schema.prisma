generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Lead {
  id             String   @id @default(cuid())
  enquiryType    String   @default("HEALTH_CHECKUP")
  fullName       String
  mobile         String
  whatsapp       String
  email          String?
  state          String
  district       String
  area           String
  pincode        String
  age            String?
  gender         String?
  package        String?
  price          String?
  membershipType String?
  serviceType    String?
  status         String   @default("New Lead")
  isCallDone     Boolean  @default(false)
  remarks        String?
  createdAt      DateTime @default(now())
}

model HealthPackage {
  id            String   @id @default(cuid())
  slug          String?  @unique
  title         String
  subtitle      String
  price         String
  originalPrice String
  discount      String
  theme         String   @default("themePink")
  image         String
  layout        String   @default("left")
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tests         PackageTest[]
  profiles      TestProfile[]
}

model PackageTest {
  id          String        @id @default(cuid())
  name        String
  parameters  String
  package     HealthPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
}

model TestProfile {
  id         String          @id @default(cuid())
  name       String          @unique
  parameters TestParameter[]
  packages   HealthPackage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TestParameter {
  id        String      @id @default(cuid())
  name      String
  profile   TestProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime    @default(now())
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  stateId   String
  areas     Area[]
  createdAt DateTime @default(now())
}

model Area {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  createdAt  DateTime @default(now())
}

model StaticPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietPlan {
  id          String             @id @default(cuid())
  title       String
  duration    String
  price       String
  priceUnit   String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  benefits    DietPlanBenefit[]
}

model DietPlanBenefit {
  id          String    @id @default(cuid())
  name        String
  dietPlan    DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  dietPlanId  String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}

model ServiceLocation {
  id           String   @id @default(cuid())
  state        String
  sNo          Int
  officeName   String
  pincode      String
  type         String
  circle       String
  region       String
  division     String
  area         String
  phleboName   String?
  phleboMobile String?
  phlebos      Json?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PatientRecord {
  id         String        @id @default(cuid())
  name       String
  phone      String
  age        String?
  gender     String?
  address    String?
  consultant String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  files      PatientFile[]
  invoices   Invoice[]
}

model PatientFile {
  id        String        @id @default(cuid())
  patient   PatientRecord @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  fileUrl   String
  fileName  String
  fileType  String        // e.g., 'PRESCRIPTION', 'BILL', 'REPORT'
  createdAt DateTime      @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  patient     PatientRecord @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  invoiceNo   String        @unique
  mrnNo       String?
  billDate    DateTime      @default(now())
  payMode     String?
  totalAmount Float         @default(0)
  discount    Float         @default(0)
  cgst        Float         @default(0)
  sgst        Float         @default(0)
  paidAmount  Float         @default(0)
  dueAmount   Float         @default(0)
  createdAt   DateTime      @default(now())
  items       InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  itemName  String
  mfr       String?
  qty       Float   @default(1)
  batch     String?
  exp       String?
  hsn       String?
  price     Float   @default(0)
  discount  Float   @default(0)
  amount    Float   @default(0)
  cgst      Float   @default(0)
  sgst      Float   @default(0)
  total     Float   @default(0)
}

model Doctor {
  id        String   @id @default(cuid())
  name      String
  type      String   // 'CONSULTANT' or 'DIETICIAN'
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportYear {
  id   String @id @default(cuid())
  year Int    @unique
}

model ReportFile {
  id           String   @id @default(cuid())
  date         DateTime
  title        String
  fileUrl      String
  fileName     String
  patientName  String?
  patientId    String?
  mobileNumber String?
  testName     String?
  labName      String?
  reference    String?
  remarks      String?

  needsReminder Boolean   @default(false)
  reminderDate  DateTime?

  createdAt    DateTime @default(now())
}

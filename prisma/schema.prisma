generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Lead {
  id             String   @id @default(cuid())
  enquiryType    String   @default("HEALTH_CHECKUP")
  fullName       String
  mobile         String
  whatsapp       String
  email          String?
  state          String
  district       String
  area           String
  pincode        String
  age            String?
  gender         String?
  package        String?
  price          String?
  membershipType String?
  serviceType    String?
  status         String   @default("New Lead")
  isCallDone     Boolean  @default(false)
  remarks        String?
  createdAt      DateTime @default(now())
}

model HealthPackage {
  id            String   @id @default(cuid())
  slug          String?  @unique
  title         String
  subtitle      String
  price         String
  originalPrice String
  discount      String
  theme         String   @default("themePink")
  image         String
  layout        String   @default("left")
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tests         PackageTest[]
  profiles      TestProfile[]
}

model PackageTest {
  id          String        @id @default(cuid())
  name        String
  parameters  String
  package     HealthPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
}

model TestProfile {
  id         String          @id @default(cuid())
  name       String          @unique
  parameters TestParameter[]
  packages   HealthPackage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TestParameter {
  id        String      @id @default(cuid())
  name      String
  profile   TestProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime    @default(now())
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  stateId   String
  areas     Area[]
  createdAt DateTime @default(now())
}

model Area {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  createdAt  DateTime @default(now())
}

model StaticPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietPlan {
  id          String             @id @default(cuid())
  title       String
  duration    String
  price       String
  priceUnit   String
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  benefits    DietPlanBenefit[]
}

model DietPlanBenefit {
  id          String    @id @default(cuid())
  name        String
  dietPlan    DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  dietPlanId  String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Lead {
  id             String   @id @default(cuid())
  enquiryType    String   @default("HEALTH_CHECKUP")
  fullName       String
  mobile         String
  whatsapp       String
  email          String?
  state          String
  district       String
  area           String
  pincode        String
  age            String?
  gender         String?
  package        String?
  price          String?
  membershipType String?
  serviceType    String?
  status         String   @default("New Lead")
  isCallDone     Boolean  @default(false)
  remarks        String?
  createdAt      DateTime @default(now())
}

model HealthPackage {
  id            String        @id @default(cuid())
  slug          String?       @unique
  title         String
  subtitle      String
  price         String
  originalPrice String
  discount      String
  theme         String        @default("themePink")
  image         String
  layout        String        @default("left")
  isPopular     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tests         PackageTest[]
  profiles      TestProfile[]
}

model PackageTest {
  id         String        @id @default(cuid())
  name       String
  parameters String
  package    HealthPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId  String
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
}

model TestProfile {
  id         String          @id @default(cuid())
  name       String          @unique
  parameters TestParameter[]
  packages   HealthPackage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TestParameter {
  id        String      @id @default(cuid())
  name      String
  profile   TestProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  createdAt DateTime    @default(now())
}

model State {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]
  createdAt DateTime   @default(now())
}

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  stateId   String
  isActive  Boolean  @default(true)
  areas     Area[]
  createdAt DateTime @default(now())
}

model Area {
  id         String   @id @default(cuid())
  name       String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  districtId String
  createdAt  DateTime @default(now())
}

model StaticPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietPlan {
  id        String            @id @default(cuid())
  title     String
  duration  String
  price     String
  priceUnit String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  benefits  DietPlanBenefit[]
}

model DietPlanBenefit {
  id         String   @id @default(cuid())
  name       String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  dietPlanId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model ServiceLocation {
  id           String   @id @default(cuid())
  state        String
  sNo          Int
  officeName   String
  pincode      String
  type         String
  circle       String
  region       String
  division     String
  area         String
  phleboName   String?
  phleboMobile String?
  phlebos      Json?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PatientRecord {
  id         String        @id @default(cuid())
  uhid       String?       @unique
  name       String
  phone      String
  age        String?
  gender     String?
  address    String?
  consultant String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  files      PatientFile[]
  invoices   Invoice[]
}

model PatientFile {
  id        String        @id @default(cuid())
  patient   PatientRecord @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  fileUrl   String
  fileName  String
  fileType  String // e.g., 'PRESCRIPTION', 'BILL', 'REPORT'
  status    String        @default("DRAFT") // 'DRAFT' or 'SUBMITTED'
  createdAt DateTime      @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  patient     PatientRecord @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId   String
  invoiceNo   String        @unique
  mrnNo       String?
  billDate    DateTime      @default(now())
  payMode     String?
  totalAmount Float         @default(0)
  discount    Float         @default(0)
  cgst        Float         @default(0)
  sgst        Float         @default(0)
  paidAmount  Float         @default(0)
  dueAmount   Float         @default(0)
  createdAt   DateTime      @default(now())
  items       InvoiceItem[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  itemName  String
  mfr       String?
  qty       Float   @default(1)
  batch     String?
  exp       String?
  hsn       String?
  price     Float   @default(0)
  discount  Float   @default(0)
  amount    Float   @default(0)
  cgst      Float   @default(0)
  sgst      Float   @default(0)
  total     Float   @default(0)
}

model Doctor {
  id                String   @id @default(cuid())
  name              String
  type              String // 'CONSULTANT' or 'DIETICIAN'
  phone             String?
  email             String?  @unique
  password          String?
  qualification     String?
  speciality        String?
  medicalCouncilReg String?
  signature         String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ReportYear {
  id   String @id @default(cuid())
  year Int    @unique
}

model ReportFile {
  id           String   @id @default(cuid())
  date         DateTime
  title        String
  fileUrl      String
  fileName     String
  patientName  String?
  patientId    String?
  mobileNumber String?
  testName     String?
  labName      String?
  reference    String?
  remarks      String?

  needsReminder Boolean   @default(false)
  reminderDate  DateTime?

  createdAt DateTime @default(now())
}

model DoctorApplication {
  id                      String   @id @default(cuid())
  fullName                String
  title                   String
  gender                  String
  dob                     String
  mobile                  String
  email                   String
  address                 String
  city                    String
  state                   String
  photoUrl                String?
  medicalQualification    String
  medicalCollege          String
  yearOfGraduation        String
  yearOfPostGraduation    String?
  medicalCouncilReg       String
  registeringAuthority    String
  registrationStatus      String
  primarySpecialization   String
  secondarySpecialization String?
  clinicalFocus           String?
  experience              String
  languages               String
  telemedicine            Boolean
  documents               Json?
  accountName             String
  bankName                String
  accountNumber           String
  ifscCode                String
  panNumber               String
  branchName              String
  signatureName           String
  signatureDate           String
  status                  String   @default("PENDING")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model DrPayout {
  id                          String   @id @default(cuid())
  consultingDoctor            String
  consultationMode            String?
  reportingPeriod             String?
  year                        String?
  totalPatientsConsulted      Int?     @default(0)
  totalConsultationsCompleted Int?     @default(0)
  totalPayoutAmount           Float?   @default(0)
  payoutDate                  String?
  paymentMode                 String?
  transactionReferenceNo      String?
  paymentScreenshotUrl        String?
  records                     Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model ReferralCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  referrers   Referrer[]
}

model Referrer {
  id           String                @id @default(cuid())
  referralCode String?               @unique
  name         String
  email        String?               @unique
  phone        String
  username     String                @unique
  password     String
  state        String?
  district     String?
  pincode      String?
  area         String?
  category     ReferralCategory      @relation(fields: [categoryId], references: [id])
  categoryId   String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  transactions ReferralTransaction[]
}

model ReferralTransaction {
  id           String   @id @default(cuid())
  referrer     Referrer @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId   String
  serviceName  String
  amount       Float    @default(0)
  servicePrice Float?
  referralDate DateTime @default(now())
  patientName  String?
  patientPhone String?
  status       String   @default("PENDING")
  comments     String?
  createdAt    DateTime @default(now())
}

model Organization {
  id          String              @id @default(cuid())
  companyName String
  hrName      String
  hrEmail     String
  hrPhone     String
  address     String?
  status      String              @default("PENDING") // PENDING, ACTIVE, INACTIVE
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  employees   CorporateEmployee[]
}

model CorporateEmployee {
  id             String                  @id @default(cuid())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  phone          String
  email          String?
  remarks        String?
  employeeId     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  consultations  CorporateConsultation[]
}

model CorporateConsultation {
  id               String            @id @default(cuid())
  employee         CorporateEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId       String
  consultationDate DateTime          @default(now())
  status           String            @default("REQUESTED") // REQUESTED, SCHEDULED, COMPLETED, CANCELLED
  notes            String?           @db.Text
  prescriptionUrl  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model FreeConsultationRequest {
  id   String @id @default(cuid())
  type String // "GENERAL" or "CORPORATE"

  // General Fields
  name   String?
  phone  String?
  email  String?
  age    String?
  gender String?

  // Corporate Fields
  employeeId       String?
  organizationName String?

  // Medical Details
  problem            String  @db.Text
  previousMedication String? @db.Text
  reportUrl          String?

  // Location
  state    String?
  district String?
  pincode  String?

  status       String   @default("PENDING")
  adminRemarks String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------
// BENVA STAFF LOGIN & ACCESS CONTROL SYSTEM (RBAC)
// ------------------------------------------------------

model Staff {
  id           String @id @default(cuid())
  employeeId   String @unique
  name         String
  mobileNumber String
  email        String @unique
  department   String
  designation  String

  username       String      @unique
  password       String
  isTemporaryPwd Boolean     @default(true)
  status         StaffStatus @default(ACTIVE)

  permissions StaffPermission[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model StaffPermission {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  moduleName String

  // Action level permissions
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)

  // Field level permissions stored as JSON
  fieldAccess Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, moduleName])
}

model AuditLog {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  action      String
  module      String
  description String?

  createdAt DateTime @default(now())
}
